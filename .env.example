# Local llama.cpp / llama-server completion endpoint
LETSVIBE_RC_LLAMA_URL=http://127.0.0.1:11435

# Optional SQLite DB and 3-day Idea Finder anti-repeat history paths
# LETSVIBE_RC_DB_PATH=data/reality_check.db
# LETSVIBE_RC_IDEA_HISTORY_PATH=data/rc_idea_history.json

# Per-IP rate limit per 10 minutes (0 disables)
LETSVIBE_RC_RATE_LIMIT=10
